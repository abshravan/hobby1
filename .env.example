# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used by scripts/seed.ts and admin routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shared secret for POST /api/admin/refresh-stats, which rebuilds the
# "X% of users have done this" view. Only needed when pg_cron is unavailable.
# Vercel Cron sends this automatically once CRON_SECRET is set on the project.
CRON_SECRET=

# ---- App ----
# Used to build absolute redirect URLs for the auth callback.
# Local: http://localhost:3000  |  Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
