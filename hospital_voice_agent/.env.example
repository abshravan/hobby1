# OpenAI API key — required.
OPENAI_API_KEY=

# Realtime (frontend) model. This POC requires gpt-live-1 and refuses to start
# with anything else.
OPENAI_REALTIME_MODEL=gpt-live-1

# Backend text model the live model delegates to. This is the model that calls
# get_hospital_info. It is NOT a realtime model.
OPENAI_BACKEND_MODEL=gpt-5.6-terra

# Where the Pipecat Tail observer serves its dashboard feed.
TAIL_HOST=localhost
TAIL_PORT=9292
